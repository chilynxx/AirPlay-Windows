// Windows resources of WinAirPlay: application icon and version information.
// Icon id 1 is what the window code loads (see apply_window_icon).
#include <winver.h>

1 ICON "winairplay.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,5,0,0
 PRODUCTVERSION 0,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinAirPlay - AirPlay & Android Screen Mirroring Receiver for Windows"
            VALUE "FileVersion", "0.5.0"
            VALUE "InternalName", "WinAirPlay"
            VALUE "OriginalFilename", "WinAirPlay.exe"
            VALUE "ProductName", "WinAirPlay"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
